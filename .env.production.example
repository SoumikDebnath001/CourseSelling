# ── VPS .env file ─────────────────────────────────────────
# Copy this to ~/cricket-academy/.env on your Hostinger VPS
# and fill in all the values.

# ── Docker ────────────────────────────────────────────────
DOCKER_USERNAME=your_dockerhub_username

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Client URL (your subdomain) ──────────────────────────
CLIENT_URL=https://YOUR_SUBDOMAIN.yourdomain.com

# ── Cloudflare R2 (PRIVATE bucket) ───────────────────────
# Files are served via short-lived presigned URLs generated by the backend, so the
# bucket can stay private — no public access / r2.dev / custom domain needed.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=courseselling
# Optional/legacy — no longer used for serving. Leave blank.
R2_PUBLIC_URL=

# ── Cloudflare Stream ────────────────────────────────────
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_CUSTOMER_CODE=

# ── Pesapal (payment gateway) ────────────────────────────
# Live keys come from your Pesapal merchant dashboard; sandbox keys from
# https://developer.pesapal.com. Set PESAPAL_ENV=live only with live keys.
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
PESAPAL_CURRENCY=KES
# Public URL of the backend IPN endpoint (through Nginx), e.g.
# https://YOUR_SUBDOMAIN.yourdomain.com/api/v1/payments/pesapal/ipn
PESAPAL_IPN_URL=
# Optional overrides
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=

# ── Mail (SMTP) ──────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-address@gmail.com
MAIL_PASS=your-16-char-app-password
MAIL_FROM="The obuya blueprint <your-address@gmail.com>"
